+def _pkg_config_path(repository_ctx, pkg_config_paths):
+    """Returns the PKG_CONFIG_PATH to run pkg-config with.
+
+    The paths declared by the rule come first; the caller's PKG_CONFIG_PATH
+    is appended rather than discarded. dreal/workspace.bzl runs in the
+    WORKSPACE dialect, which has no access to the environment, so it cannot
+    compute the active Homebrew prefix (/opt/homebrew on Apple Silicon, and
+    /usr/local on Intel) itself. The build script exports PKG_CONFIG_PATH
+    and this function honours it.
+    """
+    paths = []
+    for path in list(pkg_config_paths) + repository_ctx.os.environ.get(
+            "PKG_CONFIG_PATH", "").split(":"):
+        if path and path not in paths:
+            paths.append(path)
+    return ":".join(paths)
 
+
